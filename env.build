	###############################################################################
#! /bin/bash
###############################################################################


#set -x
#trap read debug


###############################################################################
source env.conf
###############################################################################



# COMPILER PACKAGES
###############################################################################
SRC_LIBICONV=libiconv-${LIBICONV_VERSION}.tar.gz
DST_LIBICONV=${SRC_LIBICONV%.tar.gz}

SRC_GMP=gmp-${GMP_VERSION}.tar.bz2
DST_GMP=${SRC_GMP%.tar.bz2}

SRC_ISL=isl-${ISL_VERSION}.tar.xz
DST_ISL=${SRC_ISL%.tar.xz}

SRC_MPFR=mpfr-${MPFR_VERSION}.tar.gz
DST_MPFR=${SRC_MPFR%.tar.gz}

SRC_MPC=mpc-${MPC_VERSION}.tar.gz
DST_MPC=${SRC_MPC%.tar.gz}

SRC_BINUTILS=binutils-${BINUTILS_VERSION}.tar.gz
DST_BINUTILS=${SRC_BINUTILS%.tar.gz}

SRC_GCC=gcc-${GCC_VERSION}.tar.gz
DST_GCC=${SRC_GCC%.tar.gz}

SRC_GLIBC=glibc-${GLIBC_VERSION}.tar.gz
DST_GLIBC=${SRC_GLIBC%.tar.gz}

SRC_GDB=gdb-${GDB_VERSION}.tar.gz
DST_GDB=${SRC_GDB%.tar.gz}
###############################################################################


###############################################################################
function die() { echo -e  "\033[0;31m$*\033[0m" 1>&2; exit 1; }
###############################################################################
# BUILD STATE TRACKING & FAIL-FAST MECHANISM
###############################################################################
BUILD_START_TIME=$(date +%s)
LAST_JOB=""

# Cleanup function called on exit (success or failure)
cleanup_on_exit() {
    local exit_code=$?
    
    # Only show failure message if exit code is non-zero
    if [ ${exit_code} -ne 0 ]; then
        local duration=$(($(date +%s) - BUILD_START_TIME))
        echo ""
        echo "========================================"
        echo -e "\033[0;31mBUILD FAILED after ${duration} seconds\033[0m"
        echo "========================================"
        echo -e "Last attempted: \033[0;33m${LAST_JOB}\033[0m"
        echo -e "Check logs in: \033[0;36m${BUILD_DIR}/${LAST_JOB}/\033[0m"
        echo ""
        echo "To retry after fixing the error:"
        echo -e "  \033[0;32mbash env.build\033[0m  (will resume from failed job)"
        echo ""
        echo "To clean and rebuild from scratch:"
        echo -e "  \033[0;32mbash env.build clean\033[0m"
        echo "========================================"
    fi
}

trap cleanup_on_exit EXIT
###############################################################################
# CLEAN BUILD STATE - Remove markers to force rebuild
###############################################################################
function clean_build() {
    echo "Cleaning build markers..."
    rm -f ${BUILD_DIR}/.built-*
    
    # Remove extracted folders for ALL components that have patch markers
    # Pattern: build/.patched-<component>-* → delete corresponding folder
    for patch_marker in ${BUILD_DIR}/.patched-*; do
        [ -f "${patch_marker}" ] || continue
        
        # Extract component name from marker filename
        # e.g., .patched-libiconv-mingw-mbrtowc → libiconv
        component=$(basename "${patch_marker}" | sed 's/\.patched-\([^.-]*\).*/\1/')
        
        # Map component name to folder variable and delete if exists
        case "${component}" in
            libiconv)
                if [ -d "${DST_LIBICONV}" ]; then
                    echo -e "\033[0;33m[CLEAN]\033[0m ${DST_LIBICONV}: removing patched source folder"
                    rm -rf "${DST_LIBICONV}"
                fi
                if [ -d "${BUILD_DIR}/libiconv" ]; then
                    echo -e "\033[0;33m[CLEAN]\033[0m ${BUILD_DIR}/libiconv: removing build folder"
                    rm -rf "${BUILD_DIR}/libiconv"
                fi
                ;;
            gmp)
                if [ -d "${DST_GMP}" ]; then
                    echo -e "\033[0;33m[CLEAN]\033[0m ${DST_GMP}: removing patched source folder"
                    rm -rf "${DST_GMP}"
                fi
                if [ -d "${BUILD_DIR}/gmp" ]; then
                    echo -e "\033[0;33m[CLEAN]\033[0m ${BUILD_DIR}/gmp: removing build folder"
                    rm -rf "${BUILD_DIR}/gmp"
                fi
                ;;
            isl)
                if [ -d "${DST_ISL}" ]; then
                    echo -e "\033[0;33m[CLEAN]\033[0m ${DST_ISL}: removing patched source folder"
                    rm -rf "${DST_ISL}"
                fi
                if [ -d "${BUILD_DIR}/isl" ]; then
                    echo -e "\033[0;33m[CLEAN]\033[0m ${BUILD_DIR}/isl: removing build folder"
                    rm -rf "${BUILD_DIR}/isl"
                fi
                ;;
            mpfr)
                if [ -d "${DST_MPFR}" ]; then
                    echo -e "\033[0;33m[CLEAN]\033[0m ${DST_MPFR}: removing patched source folder"
                    rm -rf "${DST_MPFR}"
                fi
                if [ -d "${BUILD_DIR}/mpfr" ]; then
                    echo -e "\033[0;33m[CLEAN]\033[0m ${BUILD_DIR}/mpfr: removing build folder"
                    rm -rf "${BUILD_DIR}/mpfr"
                fi
                ;;
            mpc)
                if [ -d "${DST_MPC}" ]; then
                    echo -e "\033[0;33m[CLEAN]\033[0m ${DST_MPC}: removing patched source folder"
                    rm -rf "${DST_MPC}"
                fi
                if [ -d "${BUILD_DIR}/mpc" ]; then
                    echo -e "\033[0;33m[CLEAN]\033[0m ${BUILD_DIR}/mpc: removing build folder"
                    rm -rf "${BUILD_DIR}/mpc"
                fi
                ;;
            binutils)
                if [ -d "${DST_BINUTILS}" ]; then
                    echo -e "\033[0;33m[CLEAN]\033[0m ${DST_BINUTILS}: removing patched source folder"
                    rm -rf "${DST_BINUTILS}"
                fi
                if [ -d "${BUILD_DIR}/binutils" ]; then
                    echo -e "\033[0;33m[CLEAN]\033[0m ${BUILD_DIR}/binutils: removing build folder"
                    rm -rf "${BUILD_DIR}/binutils"
                fi
                ;;
            gcc)
                if [ -d "${DST_GCC}" ]; then
                    echo -e "\033[0;33m[CLEAN]\033[0m ${DST_GCC}: removing patched source folder"
                    rm -rf "${DST_GCC}"
                fi
                if [ -d "${BUILD_DIR}/gcc" ]; then
                    echo -e "\033[0;33m[CLEAN]\033[0m ${BUILD_DIR}/gcc: removing build folder"
                    rm -rf "${BUILD_DIR}/gcc"
                fi
                ;;
            glibc)
                if [ -d "${DST_GLIBC}" ]; then
                    echo -e "\033[0;33m[CLEAN]\033[0m ${DST_GLIBC}: removing patched source folder"
                    rm -rf "${DST_GLIBC}"
                fi
                if [ -d "${BUILD_DIR}/glibc" ]; then
                    echo -e "\033[0;33m[CLEAN]\033[0m ${BUILD_DIR}/glibc: removing build folder"
                    rm -rf "${BUILD_DIR}/glibc"
                fi
                ;;
            gdb)
                if [ -d "${DST_GDB}" ]; then
                    echo -e "\033[0;33m[CLEAN]\033[0m ${DST_GDB}: removing patched source folder"
                    rm -rf "${DST_GDB}"
                fi
                if [ -d "${BUILD_DIR}/gdb" ]; then
                    echo -e "\033[0;33m[CLEAN]\033[0m ${BUILD_DIR}/gdb: removing build folder"
                    rm -rf "${BUILD_DIR}/gdb"
                fi
                ;;
        esac
    done
    
    # Remove all patch markers after cleaning folders
    rm -f ${BUILD_DIR}/.patched-*
    
    echo -e "\033[0;32mClean complete.\033[0m Run 'bash env.build' to rebuild."
}

# Handle clean command
if [ "$1" = "clean" ]; then
    clean_build
    exit 0
fi
###############################################################################
function unz()
{
	echo -e "\033[0;36m[EXTRACT]\033[0m $1"
	tar -$2xf $1
}
###############################################################################
# CREATE DIRS
###############################################################################
mkdir -p ${INSTALL_DIR}
mkdir -p ${HOST_TOOLS}
mkdir -p ${BUILD_DIR}
###############################################################################



# DOWNLOAD
###############################################################################
[ ! -e ${SRC_LIBICONV} ] && \
	wget http://ftpmirror.gnu.org/libiconv/${SRC_LIBICONV}
[ ! -e ${SRC_GMP} ] && \
	wget http://ftpmirror.gnu.org/gmp/${SRC_GMP}
[ ! -e ${SRC_ISL} ] && \
	wget https://libisl.sourceforge.io/${SRC_ISL}
[ ! -e ${SRC_MPFR} ] && \
	wget http://ftpmirror.gnu.org/mpfr/${SRC_MPFR}
[ ! -e ${SRC_MPC} ] && \
	wget http://ftpmirror.gnu.org/mpc/${SRC_MPC}
[ ! -e ${SRC_BINUTILS} ] && \
	wget http://ftpmirror.gnu.org/binutils/${SRC_BINUTILS}
[ ! -e ${SRC_GCC} ] && \
	wget http://ftpmirror.gnu.org/gcc/gcc-${GCC_VERSION}/${SRC_GCC}
[ ! -e ${SRC_GLIBC} ] && \
	wget http://ftpmirror.gnu.org/glibc/${SRC_GLIBC}
[ ! -e ${SRC_GDB} ] && \
	wget http://ftpmirror.gnu.org/gdb/${SRC_GDB}
###############################################################################



# UNPACK
##############################################################################
[ ! -d ${DST_LIBICONV} ]	&& [ -e ${SRC_LIBICONV} ] 	&& unz ${SRC_LIBICONV} 		z
[ ! -d ${DST_GMP} ]			&& [ -e ${SRC_GMP} ] 		&& unz ${SRC_GMP}			j
[ ! -d ${DST_ISL} ]			&& [ -e ${SRC_ISL} ] 		&& unz ${SRC_ISL}			J
[ ! -d ${DST_MPFR} ]		&& [ -e ${SRC_MPFR} ] 		&& unz ${SRC_MPFR}			z
[ ! -d ${DST_MPC} ]			&& [ -e ${SRC_MPC} ] 		&& unz ${SRC_MPC}			z
[ ! -d ${DST_BINUTILS} ]	&& [ -e ${SRC_BINUTILS} ] 	&& unz ${SRC_BINUTILS}		z
[ ! -d ${DST_GCC} ]			&& [ -e ${SRC_GCC} ] 		&& unz ${SRC_GCC}			z
[ ! -d ${DST_GLIBC} ]		&& [ -e ${SRC_GLIBC} ] 		&& unz ${SRC_GLIBC}			z
[ ! -d ${DST_GDB} ]  		&& [ -e ${SRC_GDB} ] 		&& unz ${SRC_GDB}			z
###############################################################################



# VERIFY ENVIRONMENT
###############################################################################
[ -d ${DST_LIBICONV} ] 		|| die 'LIBICONV download or extraction failed!'
[ -d ${DST_GMP} ] 			|| die 'GMP download or extraction failed!'
[ -d ${DST_ISL} ] 			|| die 'ISL download or extraction failed!'
[ -d ${DST_BINUTILS} ] 		|| die 'BINUTILS download or extraction failed!'
[ -d ${DST_MPFR} ] 			|| die 'MPFR download or extraction failed!'
[ -d ${DST_MPC} ] 			|| die 'MPC download or extraction failed!'
[ -d ${DST_GCC} ] 			|| die 'GCC download or extraction failed!'
[ -d ${DST_GLIBC} ] 		|| die 'GLIBC download or extraction failed!'
[ -d ${DST_GDB} ] 			|| die 'GDB download or extraction failed!'
###############################################################################


# APPLY PATCHES
###############################################################################
# libiconv 1.17: Fix mbrtowc conflict with MinGW-w64
if [ -f patches/libiconv-1.17-mingw-mbrtowc.patch ] && [ -d ${DST_LIBICONV} ] && \
   [ ! -f ${BUILD_DIR}/.patched-libiconv-mingw-mbrtowc ]; then
    echo -e "\033[0;36m[PATCH]\033[0m libiconv: mbrtowc fix for MinGW-w64"
    pushd ${DST_LIBICONV} >/dev/null 2>&1
    patch -p0 < ../patches/libiconv-1.17-mingw-mbrtowc.patch
    popd >/dev/null 2>&1
    touch ${BUILD_DIR}/.patched-libiconv-mingw-mbrtowc
elif [ -f ${BUILD_DIR}/.patched-libiconv-mingw-mbrtowc ]; then
    echo -e "\033[0;32m[SKIP]\033[0m libiconv patch: already applied"
fi

# GMP: Fix "long long reliability test 1" compilation error
if [ -f patches/gmp-6.3.0-long-long-reliability.patch ] && [ -d ${DST_GMP} ] && \
   [ ! -f ${BUILD_DIR}/.patched-gmp-long-long-reliability ]; then
    echo -e "\033[0;36m[PATCH]\033[0m GMP: Fix long long reliability test for MinGW-w64"
    pushd ${DST_GMP} >/dev/null 2>&1
    patch -p0 < ../patches/gmp-6.3.0-long-long-reliability.patch
    popd >/dev/null 2>&1
    touch ${BUILD_DIR}/.patched-gmp-long-long-reliability
elif [ -f ${BUILD_DIR}/.patched-gmp-long-long-reliability ]; then
    echo -e "\033[0;32m[SKIP]\033[0m GMP patch: already applied"
fi
###############################################################################


# BUILD LIBICONV
###############################################################################
function do_libiconv()
{
	export CC="${HOST}-gcc"
	export CXX="${HOST}-g++"
	export CPP="${HOST}-gcc -E"
	export AR="${HOST}-gcc-ar"
	export CFLAGS='-O2 -pipe -D__USE_MINGW_ACCESS'
	export CXXFLAGS='-O2 -pipe -D__USE_MINGW_ACCESS'

	../../libiconv-${LIBICONV_VERSION}/configure \
		--prefix=${HOST_TOOLS} \
		--build=${HOST} \
		--enable-static \
		--disable-shared \
		|| return 1

	make || return 1
	make install || return 1
	
	return 0
}
###############################################################################



# BUILD GMP
###############################################################################
function do_gmp()
{
	export CC="${HOST}-gcc"
	export CXX="${HOST}-g++"
	export CPP="${HOST}-gcc -E"
	export AR="${HOST}-gcc-ar"
	export CFLAGS='-O2 -pipe -D__USE_MINGW_ACCESS'
	export CXXFLAGS='-O2 -pipe -D__USE_MINGW_ACCESS'
	
	../../gmp-${GMP_VERSION}/configure \
		--prefix=${HOST_TOOLS} \
		--build=${HOST} \
		--enable-static \
		--disable-shared \
		|| return 1

	make || return 1
	make install || return 1
	
	return 0
}
###############################################################################



# BUILD ISL
###############################################################################
function do_isl()
{
	export CC="${HOST}-gcc"
	export CXX="${HOST}-g++"
	export CPP="${HOST}-gcc -E"
	export AR="${HOST}-gcc-ar"
	export CFLAGS='-O2 -pipe -D__USE_MINGW_ACCESS'
	export CXXFLAGS='-O2 -pipe -D__USE_MINGW_ACCESS'
	export LDFLAGS='-static -L${HOST_TOOLS}/lib'
	export CPPFLAGS='-I${HOST_TOOLS}/include'
	
	../../isl-${ISL_VERSION}/configure \
		--prefix=${HOST_TOOLS} \
		--build=${HOST} \
		--with-gmp-prefix=${HOST_TOOLS} \
		--enable-static \
		--disable-shared \
		|| return 1
		
	make || return 1
	make install || return 1
	
	return 0	
}
###############################################################################



