###############################################################################



# BUILD BINUTILS
###############################################################################
function do_binutils()
{
	export CC="${HOST}-gcc"
	export CXX="${HOST}-g++"
	export CPP="${HOST}-gcc -E"
	export AR="${HOST}-gcc-ar"
	export CFLAGS='-O2 -pipe -D__USE_MINGW_ACCESS'
	export CXXFLAGS='-O2 -pipe -D__USE_MINGW_ACCESS'
	
	../../binutils-${BINUTILS_VERSION}/configure \
		--prefix=${INSTALL_DIR} \
		--build=${HOST} \
		--target=${TARGET} \
		--with-libiconv-prefix=${HOST_TOOLS} \
		--with-isl-prefix=${HOST_TOOLS} \
		--with-gmp-prefix=${HOST_TOOLS} \
		--with-mpc-prefix=${HOST_TOOLS} \
		--with-mpfr-prefix=${HOST_TOOLS} \
		--enable-lto \
		--enable-plugins \
		--enable-gold \
		--enable-threads \
		--enable-ld=default \
		--enable-static \
		--disable-shared \
		--disable-nls \
		--disable-libssp \
		--disable-libada \
		|| return 1

	LDFLAGS='-static -liconv' make || return 1
	make install-strip || return 1
	
	return 0	
}
###############################################################################



# BUILD GCC STAGE 1
###############################################################################
function do_xgcc()
{
	export CC="${HOST}-gcc"
	export CXX="${HOST}-g++"
	export CPP="${HOST}-gcc -E"
	export AR="${HOST}-gcc-ar"
	export CFLAGS='-O2 -pipe -D__USE_MINGW_ACCESS'
	
	../../gcc-${GCC_VERSION}/configure \
		--prefix=${INSTALL_DIR} \
		--host=${HOST} \
		--build=${HOST} \
		--target=${TARGET} \
		--with-sysroot=${SYSROOT} \
		--with-libiconv-prefix=${HOST_TOOLS} \
		--with-isl=${HOST_TOOLS} \
		--with-gmp=${HOST_TOOLS} \
		--with-mpc=${HOST_TOOLS} \
		--with-mpfr=${HOST_TOOLS} \
		--with-newlib \
		--without-headers \
		--enable-languages=c \
		--disable-threads \
		--disable-shared \
		--disable-nls \
		--disable-libmudflap \
		--disable-libgomp \
		--disable-libitm \
		--disable-libquadmath \
		--disable-libsanitizer \
		--disable-libssp \
		--disable-libada \
		--disable-libvtv \
		--disable-libcilkrts \
		--disable-libatomic \
		--disable-bootstrap \
		--enable-gnu-indirect-function \
		|| return 1
		
	LDFLAGS='-L${HOST_TOOLS}/lib -Wl,-Bstatic -liconv -lgmp -lmpfr -lmpc -lisl -Wl,-Bdynamic' make || return 1
	make install-strip || return 1
	
	return 0	
}
###############################################################################


# BUILD GLIBC HEADERS (Stage 1 - before full GCC)
###############################################################################
# Installs headers only so GCC stage 2 can compile with proper target headers
function do_glibc_headers()
{
	export CC="${TARGET}-gcc"
	export CXX="${TARGET}-g++"
	export CPP="${TARGET}-gcc -E"
	export AR="${TARGET}-gcc-ar"
	# Generic flags for headers installation (xgcc stage 1 has limited target support)
	export CFLAGS='-O2 -pipe'
	
	../../glibc-${GLIBC_VERSION}/configure \
		--prefix=${INSTALL_DIR} \
		--host=${TARGET} \
		--build=${HOST} \
		--target=${TARGET} \
		--localedir=//usr//share//locale \
		--with-gnu-ld \
		--with-gnu-as \
		--with-tls \
		--without-selinux \
		--without-cvs \
		--without-gd \
		--with-headers=${SYSROOT}/usr/include \
		--disable-nls \
		--disable-sanity-checks \
		--disable-profile \
		--disable-debug \
		--enable-hacker-mode \
		libc_cv_forced_unwind=yes \
		libc_cv_c_cleanup=yes \
		libc_cv_ssp=no \
		libc_cv_ssp_strong=no \		
		libc_cv_gnu89_inline=yes || return 1
		
	# Install headers to sysroot/usr/include (not sysroot${INSTALL_DIR}/usr/include)
	make install-headers install_root=${SYSROOT} prefix=/usr || return 1
	
	return 0	
}
###############################################################################



# BUILD GCC STAGE 2
###############################################################################
function do_gcc()
{
	export CC="${HOST}-gcc"
	export CXX="${HOST}-g++"
	export CPP="${HOST}-gcc -E"
	export AR="${HOST}-gcc-ar"
	export CFLAGS='-O2 -pipe -D__USE_MINGW_ACCESS'

	../../gcc-${GCC_VERSION}/configure \
		--prefix=${INSTALL_DIR} \
		--host=${HOST} \
		--build=${HOST} \
		--target=${TARGET} ${TUNE} \
		--with-sysroot=${SYSROOT} \
		--with-libiconv-prefix=${HOST_TOOLS} \
		--with-isl=${HOST_TOOLS} \
		--with-gmp=${HOST_TOOLS} \
		--with-mpc=${HOST_TOOLS} \
		--with-mpfr=${HOST_TOOLS} \
		--enable-languages=c,c++ \
		--enable-threads=posix \
		--enable-checking=release \
		--enable-shared \
		--enable-default-ssp \
		--disable-nls \
		--disable-libmudflap \
		--disable-libssp \
		--disable-libada \
		--disable-bootstrap \
		--enable-gnu-indirect-function \
		|| return 1
		
	LDFLAGS='-L${HOST_TOOLS}/lib -Wl,-Bstatic -liconv -lgmp -lmpfr -lmpc -lisl -Wl,-Bdynamic -lpthread' make || return 1
	make install-strip || return 1
	
	return 0
}
###############################################################################



# BUILD GLIBC (Stage 2 - after full GCC)
###############################################################################
# Builds and installs full glibc library after GCC stage 2 is complete
function do_glibc()
{
	export CC="${TARGET}-gcc"
	export CXX="${TARGET}-g++"
	export CPP="${TARGET}-gcc -E"
	export AR="${TARGET}-gcc-ar"
	# Cortex-A53 tuning for Raspberry Pi 4 target
	export CFLAGS="-O2 -pipe ${GLIBC_TUNE}"
	
	../../glibc-${GLIBC_VERSION}/configure \
		--prefix=${INSTALL_DIR} \
		--host=${TARGET} \
		--build=${HOST} \
		--target=${TARGET} \
		--localedir=//usr//share//locale \
		--with-gnu-ld \
		--with-gnu-as \
		--with-tls \
		--without-selinux \
		--without-cvs \
		--without-gd \
		--with-headers=${SYSROOT}/usr/include \
		--disable-nls \
		--disable-sanity-checks \
		--disable-profile \
		--disable-debug \
		--enable-hacker-mode \
		libc_cv_forced_unwind=yes \
		libc_cv_c_cleanup=yes \
		libc_cv_ssp=no \
		libc_cv_ssp_strong=no \		
		libc_cv_gnu89_inline=yes || return 1
		
	make || return 1
	make install || return 1
	
	return 0	
}
###############################################################################


# BUILD GDB
###############################################################################
function do_gdb()
{
	export CC="${HOST}-gcc"
	export CXX="${HOST}-g++"
	export CPP="${HOST}-gcc -E"
	export AR="${HOST}-gcc-ar"
	export CFLAGS='-O2 -pipe -D__USE_MINGW_ACCESS'
	
	../../gdb-${GDB_VERSION}/configure \
		--prefix=${INSTALL_DIR} \
		--host=${HOST} \
		--build=${HOST} \
		--target=${TARGET} \
		--with-libiconv-prefix=${HOST_TOOLS} \
		--with-isl=${HOST_TOOLS} \
		--with-gmp=${HOST_TOOLS} \
		--with-mpc=${HOST_TOOLS} \
		--with-mpfr=${HOST_TOOLS} \
		--with-python=python3 \
		--enable-static \
		--disable-shared \
		|| return 1

	LDFLAGS='-L${HOST_TOOLS}/lib -Wl,-Bstatic -liconv -lgmp -lmpfr -lmpc -lisl -Wl,-Bdynamic -lpthread' make || return 1
	make install-strip || return 1
	
	return 0
}
###############################################################################
function job()
{
	mkdir -p ${BUILD_DIR}/$1
	pushd ${BUILD_DIR}/$1 >/dev/null 2>&1
	do_$1
	local result=$?
	popd >/dev/null 2>&1
	return ${result}
}
export -f job
###############################################################################
# SKIP IF ALREADY BUILT - Incremental build support
###############################################################################
job_skip_if_done() {
    local name=$1
    local marker=""
    
    # Track current job for error reporting
    LAST_JOB="${name}"
    
    # All markers stored in BUILD_DIR folder
    marker="${BUILD_DIR}/.built-${name}"
    
    if [ -f "${marker}" ]; then
        echo -e "\033[0;32m[SKIP]\033[0m ${name}: already built"
        return 0
    fi
    
    echo -e "\033[0;35m[COMPILE]\033[0m ${name}"
    if job "$name"; then
        touch "${marker}"
        echo -e "\033[0;32m[OK]\033[0m ${name}: build successful"
        return 0
    else
        echo -e "\033[0;31m[FAILED]\033[0m ${name}: build failed!"
        exit 1  # Stop build immediately - trap will show error message
    fi
}
export -f job_skip_if_done
###############################################################################
# BUILD ORDER - Components built in sequence (dependencies respected)
###############################################################################
# Stage 1: Host tools and binutils
job_skip_if_done libiconv
job_skip_if_done gmp
job_skip_if_done isl
job_skip_if_done mpfr
job_skip_if_done mpc
job_skip_if_done binutils

# Stage 2: Minimal GCC (C compiler only, no C++)
job_skip_if_done xgcc

# Stage 3: glibc headers (so GCC stage 2 has target headers)
job_skip_if_done glibc_headers

# Stage 4: Full GCC (with C++ support)
job_skip_if_done gcc

# Stage 5: Full glibc library (requires full GCC)
job_skip_if_done glibc

# Stage 6: GDB debugger
job_skip_if_done gdb

###############################################################################
# POST-BUILD: Bundle required DLLs
###############################################################################
# Copy libwinpthread-1.dll (only runtime DLL dependency)
if [ -f /mingw64/bin/libwinpthread-1.dll ]; then
    echo -e "\033[0;36m[COPY]\033[0m libwinpthread-1.dll to ${INSTALL_DIR}/bin/"
    cp /mingw64/bin/libwinpthread-1.dll ${INSTALL_DIR}/bin/
    echo -e "\033[0;32m[OK]\033[0m Toolchain ready: ${INSTALL_DIR}/"
else
    echo -e "\033[0;31m[ERROR]\033[0m libwinpthread-1.dll not found at /mingw64/bin/libwinpthread-1.dll"
    echo -e "\033[0;31m[ERROR]\033[0m Ensure MSYS2 mingw-w64-x86_64-gcc package is installed:"
    echo -e "\033[0;33m  pacman -S mingw-w64-x86_64-gcc\033[0m"
    exit 1
fi
###############################################################################
